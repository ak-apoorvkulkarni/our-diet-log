# Production bind
AHAR_HOST=0.0.0.0
AHAR_PORT=8001
AHAR_DB_PATH=data/ahar_tracker.db

# Public self-registration (leave false for testing — create users via scripts/manage_db.py)
AHAR_ALLOW_PUBLIC_REGISTER=false

# Set true when serving behind HTTPS (Cloudflare tunnel). Ensures session cookies work.
AHAR_COOKIE_SECURE=true

# Optional: create accounts on first server start (comma-separated user:password)
# AHAR_BOOTSTRAP_USERS=you:yourpassword,partner:theirpassword
