rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Returns the household id string for the current caller.
    // Stored on /users/{uid} documents to enable partner reads without a backend.
    function myHouseholdId() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId
        : null;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    // True if uid is listed in members OR appears in slots u1–u8 (covers legacy / inconsistent docs).
    function isUidInHouseholdSlots(slots, uid) {
      return slots is map
        && (slots.u1 == uid || slots.u2 == uid || slots.u3 == uid || slots.u4 == uid
          || slots.u5 == uid || slots.u6 == uid || slots.u7 == uid || slots.u8 == uid);
    }

    function isHouseholdMember(householdId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && (
          (householdData(householdId).members is list
            && householdData(householdId).members.hasAny([uid]))
          || isUidInHouseholdSlots(householdData(householdId).slots, uid)
        );
    }

    function isMember(householdId) {
      return isHouseholdMember(householdId, request.auth.uid);
    }

    function isLinkedPartnerOf(targetUid) {
      // Partner read: caller and target user share the same household id.
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(targetUid)).data.householdId
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    match /users/{uid} {
      // Minimal public profile for linking (householdId, displayName, etc).
      // Owner writes; partner can read if linked.
      allow read: if signedIn() && (request.auth.uid == uid || isLinkedPartnerOf(uid));
      allow create, update: if signedIn() && request.auth.uid == uid;
      // Owner may delete their own profile doc (account deletion in the app).
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/state/{docId} {
      // Per-user state:
      // - owner can read/write their own state
      // - partner can read (shared dashboard), but cannot write
      allow read: if signedIn() && (request.auth.uid == uid || isLinkedPartnerOf(uid));
      // Writes: shared households must exist and list the uid. Personal vault id is always u_<firebaseUid>;
      // allow that path even if the household doc is missing or malformed (solo recovery).
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.householdId is string
        && (
          request.resource.data.householdId == ("u_" + uid)
          || (
            exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
            && isHouseholdMember(request.resource.data.householdId, uid)
          )
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Meal photos on Spark (no Cloud Storage): compressed data URLs per meal (size-limited in app).
    match /users/{uid}/mealImages/{mealId} {
      allow read: if signedIn() && (request.auth.uid == uid || isLinkedPartnerOf(uid));
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /households/{householdId} {
      // Read access for signed-in users. This enables invite acceptance without a backend.
      // State documents remain protected by membership.
      allow read: if signedIn();

      // Create a new household with exactly one member: the creator.
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Allow updates if:
      // - user is already a member and new members ⊇ old (additions / same), OR
      // - the owner (slot u1) removes one or more partners: new members ⊂ old, owner stays.
      allow update: if signedIn()
        && request.resource.data.members is list
        && (
          (
            request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.hasAny([request.auth.uid])
          )
          ||
          (
            resource.data.slots is map
            && resource.data.slots.u1 == request.auth.uid
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.hasAny([request.auth.uid])
          )
        );
      // Allow deleting a household only when it is a single-member household.
      allow delete: if signedIn()
        && resource.data.members is list
        && resource.data.members.size() == 1
        && resource.data.members[0] == request.auth.uid;
    }

    match /households/{householdId}/state/{docId} {
      allow read, write: if isMember(householdId);
      // Allow deleting state only for single-member households.
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && get(/databases/$(database)/documents/households/$(householdId)).data.members is list
        && get(/databases/$(database)/documents/households/$(householdId)).data.members.size() == 1
        && get(/databases/$(database)/documents/households/$(householdId)).data.members[0] == request.auth.uid;
    }

    // Simple invite tokens. Any signed-in user may read a token to accept it,
    // but only the creating member may create it. Tokens are one-time use.
    match /invites/{token} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.householdId is string
        && request.resource.data.toEmail is string;
      allow read: if signedIn();
      // Allow updates to mark an invite as used.
      allow update: if signedIn();
      allow delete: if false;
    }
  }
}

