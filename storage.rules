rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function householdIdFor(uid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(uid))
        ? firestore.get(/databases/(default)/documents/users/$(uid)).data.householdId
        : null;
    }

    function sameHousehold(a, b) {
      return signedIn()
        && householdIdFor(a) != null
        && householdIdFor(a) == householdIdFor(b);
    }

    // Store images under users/{uid}/meals/{mealId}.jpg
    match /users/{uid}/meals/{allPaths=**} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || sameHousehold(uid, request.auth.uid));
    }

    // Backward-compat path (existing installs). Keep read-only for safety.
    match /households/{householdId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}

